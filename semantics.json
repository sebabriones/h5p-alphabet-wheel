[
  {
    "name": "instructions",
    "type": "group",
    "label": "Instructions",
    "importance": "high",
    "optional": true,
    "fields": [
      {
        "name": "enabled",
        "type": "boolean",
        "label": "Show instructions",
        "default": false
      },
      {
        "name": "text",
        "type": "text",
        "widget": "html",
        "label": "Instructions text",
        "importance": "high",
