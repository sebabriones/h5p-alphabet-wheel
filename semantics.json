[
  {
    "name": "title",
    "type": "text",
    "label": "Game title",
    "importance": "high",
    "default": "Alphabet Wheel"
  },
  {
    "name": "timeLimit",
    "type": "number",
    "label": "Time limit (seconds)",
    "importance": "medium",
    "default": 300,
    "min": 30,
    "max": 1800,
    "unit": "s"
  },
  {
    "name": "letters",
    "type": "list",
    "label": "Letters and questions",
    "importance": "high",
    "entity": "letter",
    "field": {
      "name": "letterItem",
      "type": "group",
      "label": "Letter",
      "fields": [
        {
          "name": "letter",
          "type": "select",
          "label": "Letter",
          "default": "A",
          "options": [
            {
              "value": "A",
              "label": "A"
