            },
            {
              "value": "Y",
              "label": "Y"
            },
            {
              "value": "Z",
              "label": "Z"
            }
          ]
        },
        {
          "name": "definition",
          "type": "text",
          "label": "Definition / question",
          "widget": "textarea",
          "description": "Required. Shown when this letter is active. Letters missing definition or answer do not appear on the wheel."
        },
        {
          "name": "answer",
          "type": "text",
          "label": "Correct answer",
          "description": "Required. Expected answer for this letter."
        }
      ]
    },
    "default": [
      {
        "letter": "A",
        "definition": "",
        "answer": ""
      }
    ],
    "min": 1,
    "defaultNum": 1,
    "description": "Add only the letters that take part in the wheel. Items without both a definition and a correct answer are ignored when playing."
  },
  {
    "name": "behaviour",
    "type": "group",
    "label": "Behavioural settings",
    "importance": "low",
    "fields": [
      {
        "name": "caseSensitive",
        "type": "boolean",
        "label": "Case sensitive answers",
        "default": false
      },
      {
        "name": "ignoreAccents",
        "type": "boolean",
        "label": "Ignore accents",
        "default": true
      },
      {
        "name": "allowPass",
        "type": "boolean",
        "label": "Allow pass",
        "default": true,
        "description": "Lets the learner skip a letter and come back later."
      },
      {
        "name": "showScore",
        "type": "boolean",
        "label": "Show score during the game",
        "default": true
      },
      {
        "name": "enableRetry",
        "type": "boolean",
        "label": "Enable \"Retry\" button",
        "importance": "medium",
        "default": true,
        "description": "Lets the learner play the activity again after it finishes."
      }
    ]
  },
  {
    "name": "overallFeedback",
    "type": "group",
    "label": "Overall feedback",
    "importance": "low",
    "description": "Message shown on the results slide at the end, according to the percentage of correct letters.",
    "fields": [
      {
        "name": "popupBackgroundColor",
        "type": "text",
        "widget": "colorSelector",
        "label": "Popup background color",
        "default": "#ffffff",
        "importance": "low",
        "optional": true,
        "spectrum": {
          "showInput": true
        },
        "description": "Background color of the result popup."
      },
      {
        "name": "feedbackTextColor",
        "type": "text",
        "widget": "colorSelector",
        "label": "Feedback text color",
        "default": "#333333",
        "importance": "low",
        "optional": true,
        "spectrum": {
          "showInput": true
        },
        "description": "Text color of the message inside the popup."
      },
      {
        "name": "overallFeedback",
        "type": "list",
        "widgets": [
          {
            "name": "RangeList",
            "label": "Default"
          }
        ],
        "importance": "high",
        "label": "Define custom feedback for any score range",
        "description": "Click the \"Add range\" button to add as many ranges as you need. Example: 0-20% Low score, 21-90% Average score, 91-100% Great score. @score and @total are replaced by the score and the maximum score.",
        "entity": "range",
        "min": 1,
        "defaultNum": 1,
        "optional": true,
        "field": {
          "name": "overallFeedback",
          "type": "group",
          "importance": "low",
          "fields": [
            {
              "name": "from",
              "type": "number",
              "label": "Score range",
              "min": 0,
              "max": 100,
              "default": 0,
              "unit": "%"
            },
            {
              "name": "to",
              "type": "number",
              "min": 0,
              "max": 100,
              "default": 100,
              "unit": "%"
            },
            {
              "name": "feedback",
              "type": "text",
              "maxLength": 2048,
              "label": "Feedback for defined score range",
              "importance": "low",
              "placeholder": "Fill in the feedback",
              "optional": true
            },
            {
              "name": "appearance",
              "type": "group",
              "label": "Appearance settings",
              "importance": "low",
              "expanded": false,
              "optional": true,
              "fields": [
                {
                  "name": "feedbackLeadText",
                  "type": "text",
                  "maxLength": 2048,
                  "label": "Highlighted lead text",
                  "importance": "low",
                  "placeholder": "e.g. Correct! or Keep practicing",
                  "optional": true
                },
                {
                  "name": "feedbackLeadBold",
                  "type": "boolean",
                  "label": "Bold lead text",
                  "importance": "low",
                  "default": true
                },
                {
                  "name": "feedbackLeadTextColor",
                  "type": "text",
                  "widget": "colorSelector",
                  "label": "Highlighted lead text color",
                  "default": "#1a73d9",
                  "importance": "low",
                  "optional": true,
                  "spectrum": {
                    "showInput": true
                  }
                },
                {
                  "name": "feedbackTextAlign",
                  "type": "select",
                  "label": "Text alignment",
                  "description": "Only used when no feedback image is set. With an image, text alignment follows image position (left/right: left aligned, above: centered).",
                  "importance": "low",
                  "default": "left",
                  "options": [
                    {
                      "value": "left",
                      "label": "Left"
                    },
                    {
                      "value": "center",
                      "label": "Center"
                    },
                    {
                      "value": "right",
                      "label": "Right"
                    }
                  ]
                },
                {
                  "name": "feedbackImage",
                  "type": "image",
                  "label": "Feedback image",
                  "importance": "low",
                  "optional": true
                },
                {
                  "name": "feedbackImagePosition",
                  "type": "select",
                  "label": "Image position",
                  "importance": "low",
                  "default": "left",
                  "options": [
                    {
                      "value": "above",
                      "label": "Above text"
                    },
                    {
                      "value": "left",
                      "label": "Left of text"
                    },
                    {
                      "value": "right",
                      "label": "Right of text"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  },
  {
    "name": "design",
    "type": "group",
    "label": "Design",
    "importance": "low",
    "fields": [
      {
        "name": "wheelColor",
        "type": "text",
        "widget": "colorSelector",
        "label": "Wheel letter color",
        "default": "#3498db",
        "optional": true,
        "spectrum": {
          "showInput": true
        }
      },
      {
        "name": "correctColor",
        "type": "text",
        "widget": "colorSelector",
        "label": "Correct letter color",
        "default": "#2ecc71",
        "optional": true,
        "spectrum": {
          "showInput": true
        }
      },
      {
        "name": "wrongColor",
        "type": "text",
        "widget": "colorSelector",
        "label": "Incorrect letter color",
        "default": "#e74c3c",
        "optional": true,
        "spectrum": {
          "showInput": true
        }
      }
    ]
  },
  {
    "name": "l10n",
    "type": "group",
    "label": "Localize",
    "importance": "low",
    "common": true,
    "fields": [
      {
        "name": "submitButton",
        "type": "text",
        "label": "Submit button",
        "default": "Answer"
      },
      {
        "name": "passButton",
        "type": "text",
        "label": "Pass button",
        "default": "Pass"
      },
      {
        "name": "tryAgain",
        "type": "text",
        "label": "Retry button",
        "default": "Try again"
      },
      {
        "name": "showSolution",
        "type": "text",
        "label": "Show solution button",
        "default": "Show solution"
      },
      {
        "name": "answerPlaceholder",
        "type": "text",
        "label": "Answer input placeholder",
        "default": "Type your answer..."
      },
      {
        "name": "timeLabel",
        "type": "text",
        "label": "Timer label",
        "default": "Time: @time s",
        "description": "@time is replaced by the seconds left."
      },
      {
        "name": "scoreLabel",
        "type": "text",
        "label": "Score label",
        "default": "Score: @score",
        "description": "@score is replaced by the current score."
      },
      {
        "name": "emptyContent",
        "type": "text",
        "label": "Empty content message",
        "default": "Add at least one letter with a definition and a correct answer."
      },
      {
        "name": "emptyAnswer",
        "type": "text",
        "label": "Empty answer message",
        "default": "Please enter an answer"
      },
      {
        "name": "correctFeedback",
        "type": "text",
        "label": "Correct feedback",
        "default": "Correct!"
      },
      {
        "name": "incorrectFeedback",
        "type": "text",
        "label": "Incorrect feedback",
        "default": "Incorrect. The answer was: @answer",
        "description": "@answer is replaced by the correct answer."
      },
      {
        "name": "finishedLabel",
        "type": "text",
        "label": "Finished heading",
        "default": "Game finished"
      },
      {
        "name": "finishedSummary",
        "type": "text",
        "label": "Finished summary",
        "default": "Correct answers: @score/@total",
        "description": "@score and @total are replaced by the score and the number of letters on the wheel."
      },
      {
        "name": "scoreBarLabel",
        "type": "text",
        "label": "Score bar label",
        "default": "You got :num out of :total points"
      }
    ]
  }
]
