    "default": [
      {
        "letter": "A",
        "definition": "",
        "answer": ""
      }
    ],
    "min": 1,
    "defaultNum": 1,
    "description": "Add only the letters that take part in the wheel. Items without both a definition and a correct answer are ignored when playing."
  },
  {
    "name": "behaviour",
    "type": "group",
    "label": "Behavioural settings",
    "importance": "low",
    "fields": [
      {
        "name": "caseSensitive",
        "type": "boolean",
        "label": "Case sensitive answers",
        "default": false
      },
      {
        "name": "ignoreAccents",
        "type": "boolean",
        "label": "Ignore accents",
        "default": true
      },
      {
        "name": "allowPass",
        "type": "boolean",
        "label": "Allow pass",
        "default": true,
        "description": "Lets the learner skip a letter and come back later."
      },
      {
        "name": "showScore",
        "type": "boolean",
        "label": "Show score during the game",
        "default": true
      }
    ]
  },
  {
    "name": "design",
    "type": "group",
    "label": "Design",
    "importance": "low",
    "fields": [
      {
        "name": "wheelColor",
        "type": "text",
        "widget": "colorSelector",
        "label": "Wheel letter color",
        "default": "#3498db",
        "optional": true,
        "spectrum": {
          "showInput": true
        }
      },
      {
        "name": "correctColor",
        "type": "text",
        "widget": "colorSelector",
        "label": "Correct letter color",
        "default": "#2ecc71",
        "optional": true,
        "spectrum": {
          "showInput": true
        }
      },
      {
        "name": "wrongColor",
        "type": "text",
        "widget": "colorSelector",
        "label": "Incorrect letter color",
        "default": "#e74c3c",
        "optional": true,
        "spectrum": {
          "showInput": true
        }
      }
    ]
  },
  {
    "name": "l10n",
    "type": "group",
    "label": "Localize",
    "importance": "low",
    "common": true,
    "fields": [
      {
        "name": "submitButton",
        "type": "text",
        "label": "Submit button",
        "default": "Answer"
      },
      {
        "name": "passButton",
        "type": "text",
        "label": "Pass button",
        "default": "Pass"
      },
      {
        "name": "tryAgain",
        "type": "text",
        "label": "Retry button",
        "default": "Try again"
      },
      {
        "name": "showSolution",
        "type": "text",
        "label": "Show solution button",
        "default": "Show solution"
      },
      {
        "name": "answerPlaceholder",
        "type": "text",
        "label": "Answer input placeholder",
        "default": "Type your answer..."
      },
      {
        "name": "timeLabel",
        "type": "text",
        "label": "Timer label",
        "default": "Time: @time s",
        "description": "@time is replaced by the seconds left."
      },
      {
        "name": "scoreLabel",
        "type": "text",
        "label": "Score label",
        "default": "Score: @score",
        "description": "@score is replaced by the current score."
      },
      {
        "name": "emptyContent",
        "type": "text",
        "label": "Empty content message",
        "default": "Add at least one letter with a definition and a correct answer."
      },
      {
        "name": "emptyAnswer",
        "type": "text",
        "label": "Empty answer message",
        "default": "Please enter an answer"
      },
      {
        "name": "correctFeedback",
        "type": "text",
        "label": "Correct feedback",
        "default": "Correct!"
      },
      {
        "name": "incorrectFeedback",
        "type": "text",
        "label": "Incorrect feedback",
        "default": "Incorrect. The answer was: @answer",
        "description": "@answer is replaced by the correct answer."
      },
      {
        "name": "finishedLabel",
        "type": "text",
        "label": "Finished heading",
        "default": "Game finished"
      },
      {
        "name": "finishedSummary",
        "type": "text",
        "label": "Finished summary",
        "default": "Correct answers: @score/@total",
        "description": "@score and @total are replaced by the score and the number of letters on the wheel."
      }
    ]
  }
]
