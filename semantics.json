          "p",
          "br",
          "strong",
          "em",
          "ul",
          "ol",
          "li"
        ]
      },
      {
        "name": "displayMode",
        "type": "select",
        "label": "Display mode",
        "default": "both",
        "options": [
          {
            "value": "intro",
            "label": "Intro only"
          },
          {
            "value": "tab",
            "label": "Tab only"
          },
          {
            "value": "both",
            "label": "Intro and tab"
          }
        ]
      },
      {
        "name": "introButtonLabel",
        "type": "text",
        "label": "Intro button label",
        "default": "Start",
        "optional": true
      },
      {
        "name": "tabButtonLabel",
        "type": "text",
        "label": "Tab button label (closed)",
        "description": "Shown when the instructions tab is collapsed.",
        "default": "Instructions",
        "optional": true
      },
      {
        "name": "tabButtonLabelOpen",
        "type": "text",
        "label": "Tab button label (open)",
        "description": "Shown when the instructions tab is expanded. If empty, reuses the closed label.",
        "default": "Hide",
        "optional": true
      },
      {
        "name": "startCollapsed",
        "type": "boolean",
        "label": "Collapse tab on load",
        "default": true
      },
      {
        "name": "animation",
        "type": "group",
        "label": "Animation",
        "importance": "low",
        "optional": true,
        "fields": [
          {
            "name": "introDuration",
            "type": "number",
            "label": "Intro curtain duration",
            "description": "Opening/closing speed for the intro curtain in milliseconds.",
            "default": 600,
            "min": 0,
            "max": 5000,
            "step": 50,
            "unit": "ms"
          },
          {
            "name": "tabDuration",
            "type": "number",
            "label": "Tab open/close duration",
            "description": "Opening/closing speed for the instructions tab in milliseconds.",
            "default": 600,
            "min": 0,
            "max": 5000,
            "step": 50,
            "unit": "ms"
          },
          {
            "name": "tabClosedOffset",
            "type": "number",
            "label": "Tab closed extra offset",
            "description": "Extra offset (in px) applied when the tab is closed. 0 keeps it flush; higher values hide it more.",
            "default": 0,
            "min": 0,
            "max": 5,
            "step": 1,
            "unit": "px"
          }
        ]
      },
