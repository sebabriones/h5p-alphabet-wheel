        {
          "name": "definition",
          "type": "text",
          "label": "Definition / question",
          "widget": "textarea",
          "description": "Required. Shown when this letter is active. Letters missing definition or answer do not appear on the wheel."
        },
        {
          "name": "answer",
          "type": "text",
          "label": "Correct answer",
          "description": "Required. Expected answer for this letter."
        }
      ]
